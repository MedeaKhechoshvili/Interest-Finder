APP_NAME=InterestFinder API
APP_VERSION=1.0.0
ENVIRONMENT=development
DATABASE_URL=sqlite:///./interestfinder.db
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
LOG_LEVEL=INFO

# Replace this value locally.
JWT_SECRET_KEY=change-me-in-env
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

TMDB_ACCESS_TOKEN=change-me-in-env
GOOGLE_BOOKS_API_KEY=change-me-in-env
OPENTRIPMAP_API_KEY=change-me-in-env
MUSICBRAINZ_USER_AGENT=InterestFinder/0.1 (https://github.com/MedeaKhechoshvili/Interest-Finder)